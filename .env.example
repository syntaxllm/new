# ==============================================
# MeetingAI Environment Configuration Template
# ==============================================

# --- 1. Server Settings ---
PORT=5656
NODE_ENV=production

# --- 2. Database (MongoDB Atlas) ---
# Connection string to your MongoDB Cloud Cluster
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=meetingAI
MONGO_DB=meeting_ai_prod

# --- 3. Intelligence (Groq / Llama 3) ---
# Get Key: https://console.groq.com/keys# AI (Groq) - Rate Limit Rotation Supported
# Provide multiple keys separated by commas for automatic failover
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GROQ_API_KEY=your_groq_api_key_here # Legacy fallback

# Redis (For Key Rotation State)
REDIS_URL=redis://localhost:6379 .

# --- 4. Microsoft 365 Integration (Azure AD) ---
# Create App: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
AZURE_CLIENT_ID=your_client_id_uuid
AZURE_TENANT_ID=your_tenant_id_uuid
AZURE_CLIENT_SECRET=your_client_secret_value
# Ensure this matches the Redirect URI in Azure Portal
AZURE_REDIRECT_URI=http://localhost:5656/api/auth/callback

# --- 5. Security ---
# Generate a random string: openssl rand -base64 32
JWT_SECRET=replace_with_long_random_secure_string

# --- 6. Optional / Future Features ---
# GEMINI_API_KEY=... (Required only if enabling Vector Search)
# OPENAI_API_KEY=... (Alternative cloud STT provider)

# --- 7. Bot & STT Service ---
BOT_SERVICE_URL=http://localhost:6767
STT_SERVICE_URL=http://localhost:4545
# STT_MODE controls which transcription engine:
#   'cloud'      → Groq/OpenAI cloud API only (fast, reliable)
#   'local'      → Try local faster-whisper first, fallback to cloud
#   'local_only' → Local faster-whisper only, no cloud
STT_MODE=cloud